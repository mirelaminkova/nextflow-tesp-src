// TEMPORARY, hand-written stand-in for the catalog item's Nextflow config.
// Issue #2 will replace this file with the config rendered by the playbook's own
// template, so that the e2e job tests what the catalog item actually deploys.
// Until then, keep the TES credentials in sync with compose.basic-auth.yaml.
// All values are throwaway CI test values (the S3 keys are tesp-api's MinIO test credentials).

plugins {
    id 'nf-ga4gh@1.5.0'
}

process.executor = 'tes'

tes {
    // nginx in front of tesp-api, like on a TESP workspace: /tes/ -> 127.0.0.1:8080/
    endpoint      = 'http://localhost:8088/tes'
    basicUsername = 'tes'
    basicPassword = 'tEsP+e2e/Pa55w0rd=='
}

// tesp-api presigns s3:// inputs and outputs against the MinIO of its compose stack.
workDir = 's3://tesp-test/work'

aws {
    accessKey = 'tesp-test'
    secretKey = 'tesp-test-secret'
    region    = 'us-east-1'
    client {
        endpoint          = 'http://172.17.0.1:9000'
        s3PathStyleAccess = true
    }
}
